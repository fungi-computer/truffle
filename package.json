{
  "name": "@fungi.computer/truffle",
  "version": "0.6.0",
  "private": false,
  "description": "Truffle: Fungi's local Agent runtime, bundled into the fungi command",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fungi-local-auth": "./dist/auth-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./acp-stdio": {
      "types": "./dist/private-local-acp-stdio.d.ts",
      "import": "./dist/private-local-acp-stdio.js"
    },
    "./auth": {
      "types": "./dist/auth-cli.d.ts",
      "import": "./dist/auth-cli.js"
    },
    "./service": {
      "types": "./dist/private-local-service.d.ts",
      "import": "./dist/private-local-service.js"
    },
    "./service-process": {
      "types": "./dist/private-local-service-listener.d.ts",
      "import": "./dist/private-local-service-listener.js"
    },
    "./computer-backend": {
      "types": "./dist/private-local-computer-backend.d.ts",
      "import": "./dist/private-local-computer-backend.js"
    },
    "./login": {
      "types": "./dist/local-login.d.ts",
      "import": "./dist/local-login.js"
    },
    "./skills": {
      "types": "./dist/local-skill-source.d.ts",
      "import": "./dist/local-skill-source.js"
    },
    "./apps": {
      "types": "./dist/team-apps.d.ts",
      "import": "./dist/team-apps.js"
    },
    "./extensions": {
      "types": "./dist/local-extensions.d.ts",
      "import": "./dist/local-extensions.js"
    },
    "./upgrade": {
      "types": "./dist/local-upgrade.d.ts",
      "import": "./dist/local-upgrade.js"
    },
    "./rules": {
      "types": "./dist/private-local-exec-rules.d.ts",
      "import": "./dist/private-local-exec-rules.js"
    },
    "./board-agents": {
      "types": "./dist/local-board-agents.d.ts",
      "import": "./dist/local-board-agents.js"
    },
    "./board-shipping": {
      "types": "./dist/local-board-shipping.d.ts",
      "import": "./dist/local-board-shipping.js"
    }
  },
  "files": [
    "dist",
    "computerd-loopback.cjs",
    "native/bin"
  ],
  "scripts": {
    "lint": "../../node_modules/.bin/eslint src scripts test --max-warnings=0 && ../../node_modules/.bin/oxlint --config ../../oxlint.config.ts --deny-warnings src scripts test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "if [ ! -f src/private-local-native-digests.js ]; then pnpm run build:native; fi && node scripts/generate-native-digests.mjs --verify && pnpm run clean && tsc -p tsconfig.build.json && cp src/private-local-native-digests.js dist/private-local-native-digests.js && node scripts/copy-seatbelt.mjs && esbuild src/internal/private-workerd-sandbox-worker.mjs --outfile=dist/internal/private-workerd-sandbox-worker.mjs --bundle --format=esm --platform=neutral --conditions=workerd,browser --target=es2024 --external:cloudflare:workers --metafile=dist/internal/sandbox-metafile.json --log-level=warning && esbuild src/internal/local-image-fit-worker.mjs --outfile=dist/internal/local-image-fit-worker.mjs --bundle --format=esm --platform=node --target=es2024 --metafile=dist/internal/image-fit-metafile.json --log-level=warning",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "test": "pnpm run test:node && pnpm run test:merge && pnpm run test:stop-all",
    "soak:memory": "bun scripts/service-memory-soak.mjs",
    "soak:sqlite-open-close": "bun scripts/sqlite-open-close-repro.mjs",
    "test:stop-all": "bun test ./test/private-local-stop-all.bun.test.ts",
    "test:full": "pnpm run test && pnpm run test:bun",
    "test:node": "../../node_modules/.bin/vitest run",
    "test:sandbox:native": "../../node_modules/.bin/vitest run --config vitest.native.config.ts",
    "test:bun": "pnpm run test:mesh-link && pnpm run test:bun:batch && bun test ./test/private-workerd-deadline.bun.test.ts",
    "test:mesh-link": "bun test ./test/private-local-mesh-links.bun.test.ts",
    "test:bun:batch": "bun test ./test/private-sqlite-approval-driver.bun.test.ts ./test/mcp-form-service.bun.test.ts ./test/private-local-service-discovery.bun.test.ts ./test/private-local-service-listener.bun.test.ts ./test/private-local-schedules.bun.test.ts ./test/private-local-service-manager.bun.test.ts ./test/private-local-service-rebind.bun.test.ts ./test/private-local-service-stop.bun.test.ts ./test/private-local-service-ensure.bun.test.ts ./test/private-local-service-identity.bun.test.ts ./test/private-local-service-kill-resume.bun.test.ts ./test/private-local-service-idle-owners.bun.test.ts ./test/private-local-service-idle-delegation.bun.test.ts ./test/private-local-mail-retry.bun.test.ts ./test/private-local-service-log-native.bun.test.ts ./test/private-local-service-log.bun.test.ts ./test/private-local-sqlite-lifetime.bun.test.ts ./test/private-sqlite-driver.bun.test.ts ./test/private-local-reload.bun.test.ts ./test/private-local-auth-rpc.bun.test.ts ./test/private-workerd-forage.bun.test.ts ./test/local-extensions.bun.test.ts ./test/local-extension-archive.bun.test.ts ./test/local-zookeeper-slot.bun.test.ts ./test/local-extension-skills.bun.test.ts ./test/private-local-sandbox-service.bun.test.ts ./test/private-local-native-service.bun.test.ts",
    "build:native": "fungi-apply-patch-build --out native/bin && node scripts/build-bwrap.mjs --out native/bin && node scripts/generate-native-digests.mjs",
    "test:patch": "node --test --test-timeout=30000 test/apply-patch.native.mjs",
    "test:sandbox:linux": "node --import tsx test/fixtures/local-sandbox-proof.mts",
    "test:sandbox:macos": "scratch=$(mktemp -d /tmp/fungi-seatbelt.XXXXXX) && trap 'rm -rf \"$scratch\"' EXIT && scratch=$(cd \"$scratch\" && pwd -P) && mkdir -m 700 \"$scratch/home\" \"$scratch/runtime\" && HOME=\"$scratch/home\" XDG_CONFIG_HOME=\"$scratch/home/.config\" XDG_CACHE_HOME=\"$scratch/home/.cache\" XDG_DATA_HOME=\"$scratch/home/.local/share\" XDG_RUNTIME_DIR=\"$scratch/runtime\" node --import tsx scripts/seatbelt-mac-proof.mjs \"$scratch\"",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs",
    "test:unit": "node ../../tooling/repository/scripts/test-file-pool.mjs pnpm run test:node && pnpm run test:mesh-link && pnpm run test:bun:batch && pnpm run test:stop-all",
    "test:merge": "pnpm run test:sandbox:native && pnpm run test:patch && case \"$(uname -s)\" in Darwin) pnpm run test:sandbox:macos ;; *) pnpm run test:sandbox:linux ;; esac",
    "proof:goal-loop-sol": "bun scripts/goal-loop-model-proof.mjs",
    "proof:unpatched-login": "node scripts/prove-unpatched-login.mjs",
    "proof:sqlite-close": "bun test ./test/private-local-sqlite-close.bun.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@cf-wasm/photon": "0.4.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@effect/platform-node": "4.0.2",
    "@fungi.computer/agar": "workspace:*",
    "@fungi.computer/approvals": "workspace:*",
    "@fungi.computer/bird-dog": "workspace:*",
    "@fungi.computer/cairn": "workspace:*",
    "@fungi.computer/capnweb": "workspace:*",
    "@fungi.computer/carrier": "workspace:*",
    "@fungi.computer/cordyceps": "workspace:*",
    "@fungi.computer/gills": "workspace:*",
    "@fungi.computer/graft": "workspace:*",
    "@fungi.computer/knapsack": "workspace:*",
    "@fungi.computer/lantern": "workspace:*",
    "@fungi.computer/mycelium": "workspace:*",
    "@fungi.computer/nacre": "workspace:*",
    "@fungi.computer/seam": "workspace:*",
    "@fungi.computer/shiitake": "workspace:*",
    "@fungi.computer/shiitake-extensions": "workspace:*",
    "@fungi.computer/veil": "workspace:*",
    "@fungi.computer/watchdog": "workspace:*",
    "@fungi.computer/whistle": "workspace:*",
    "@fungi.computer/zookeeper": "workspace:*",
    "@jellybrick/dbus-next": "0.11.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@napi-rs/keyring": "2.1.2",
    "diff": "8.0.4",
    "effect": "4.0.2",
    "eventsource": "5.1.1",
    "hono": "4.13.5",
    "image-size": "2.0.4",
    "jose": "6.2.11",
    "miniflare": "5.20260828.0-alpha",
    "npm-package-arg": "14.0.0",
    "proper-lockfile": "4.1.2",
    "re2js": "1.3.3",
    "semver": "7.8.5",
    "shell-quote": "1.10.0",
    "write-file-atomic": "8.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/codemode": "0.5.1",
    "@fungi.computer/mule": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "24.13.3",
    "@types/npm-package-arg": "6.1.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.8.0",
    "@types/write-file-atomic": "4.0.3",
    "bun": "1.4.4",
    "bun-types": "1.4.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "runtime",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": {
        "status": "not-applicable",
        "reason": "Truffle ships inside @fungi.computer/spore and owns no generated API documentation surface"
      },
      "pack": {
        "status": "not-applicable",
        "reason": "Truffle is bundled into @fungi.computer/spore and not packed on its own"
      },
      "smoke": {
        "status": "not-applicable",
        "reason": "Focused synthetic persistence and Pi integration tests are the current runtime proof"
      },
      "stranger": {
        "status": "not-applicable",
        "reason": "Truffle is bundled into @fungi.computer/spore; the packed fungi stranger install is its consumer proof"
      }
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
