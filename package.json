{
  "name": "@fungi.computer/truffle",
  "version": "0.22.14",
  "private": false,
  "description": "Truffle: Fungi's local Agent runtime, bundled into the fungi command",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fungi-local-computer": "./dist/computer-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./acp-stdio": {
      "types": "./dist/private-local-acp-stdio.d.ts",
      "import": "./dist/private-local-acp-stdio.js"
    },
    "./auth": {
      "types": "./dist/auth-cli.d.ts",
      "import": "./dist/auth-cli.js"
    },
    "./service": {
      "types": "./dist/private-local-service.d.ts",
      "import": "./dist/private-local-service.js"
    },
    "./service-process": {
      "types": "./dist/private-local-service-supervisor.d.ts",
      "import": "./dist/private-local-service-supervisor.js"
    },
    "./computer-backend": {
      "types": "./dist/private-local-computer-backend.d.ts",
      "import": "./dist/private-local-computer-backend.js"
    },
    "./login": {
      "types": "./dist/local-login.d.ts",
      "import": "./dist/local-login.js"
    },
    "./skills": {
      "types": "./dist/local-skill-source.d.ts",
      "import": "./dist/local-skill-source.js"
    },
    "./apps": {
      "types": "./dist/team-apps.d.ts",
      "import": "./dist/team-apps.js"
    },
    "./extensions": {
      "types": "./dist/local-extensions.d.ts",
      "import": "./dist/local-extensions.js"
    },
    "./upgrade": {
      "types": "./dist/local-upgrade.d.ts",
      "import": "./dist/local-upgrade.js"
    },
    "./rules": {
      "types": "./dist/private-local-exec-rules.d.ts",
      "import": "./dist/private-local-exec-rules.js"
    },
    "./board-agents": {
      "types": "./dist/local-board-agents.d.ts",
      "import": "./dist/local-board-agents.js"
    },
    "./board-shipping": {
      "types": "./dist/local-board-shipping.d.ts",
      "import": "./dist/local-board-shipping.js"
    }
  },
  "files": [
    "dist",
    "computerd-loopback.cjs",
    "native/bin"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "if [ ! -f src/private-local-native-digests.js ]; then pnpm run build:native; fi && node scripts/generate-native-digests.mjs --verify && pnpm run clean && tsc -p tsconfig.build.json && cp src/private-local-native-digests.js dist/private-local-native-digests.js && node scripts/copy-seatbelt.mjs && esbuild src/internal/private-workerd-sandbox-worker.mjs --outfile=dist/internal/private-workerd-sandbox-worker.mjs --bundle --format=esm --platform=neutral --conditions=workerd,browser --target=es2024 --external:cloudflare:workers --metafile=dist/internal/sandbox-metafile.json --log-level=warning && esbuild src/internal/local-image-fit-worker.mjs --outfile=dist/internal/local-image-fit-worker.mjs --bundle --format=esm --platform=node --target=es2024 --metafile=dist/internal/image-fit-metafile.json --log-level=warning && pnpm run build:service-worker",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "soak:memory": "bun scripts/service-memory-soak.mjs",
    "soak:sqlite-open-close": "bun scripts/sqlite-open-close-repro.mjs",
    "build:native": "fungi-apply-patch-build --out native/bin && node scripts/build-bwrap.mjs --out native/bin && node scripts/generate-native-digests.mjs",
    "fixture:historical-store": "node --import tsx test/fixtures/historical-store.generator.mts",
    "measure:agent-prompt": "node --import tsx scripts/measure-agent-prompt.mjs",
    "proof:goal-loop-sol": "bun scripts/goal-loop-model-proof.mjs",
    "proof:unpatched-login": "node scripts/prove-unpatched-login.mjs",
    "proof:sqlite-close": "bun test ./test/private-local-sqlite-close.bun.test.ts",
    "build:service-worker": "esbuild src/private-local-service-worker.mjs --outfile=dist/private-local-service-worker.mjs --bundle --format=esm --platform=node --conditions=bun --target=es2024 --external:bun --external:bun:* --external:miniflare --external:@napi-rs/keyring --metafile=dist/internal/service-worker-metafile.json --log-level=warning"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@cf-wasm/photon": "0.4.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@effect/platform-node": "4.0.2",
    "@fungi.computer/agar": "0.29.4",
    "@fungi.computer/approvals": "0.4.0",
    "@fungi.computer/bird-dog": "0.3.10",
    "@fungi.computer/cairn": "0.1.1",
    "@fungi.computer/capnweb": "0.12.0-fungi.0",
    "@fungi.computer/carrier": "0.2.8",
    "@fungi.computer/cordyceps": "0.4.3",
    "@fungi.computer/gills": "0.4.0",
    "@fungi.computer/graft": "0.2.76",
    "@fungi.computer/knapsack": "0.4.36",
    "@fungi.computer/lantern": "0.4.2",
    "@fungi.computer/mycelium": "0.5.5",
    "@fungi.computer/nacre": "0.9.17",
    "@fungi.computer/seam": "0.2.9",
    "@fungi.computer/shiitake": "0.24.0",
    "@fungi.computer/shiitake-extensions": "0.15.0",
    "@fungi.computer/veil": "0.11.17",
    "@fungi.computer/watchdog": "0.1.7",
    "@fungi.computer/whistle": "0.3.0",
    "@fungi.computer/zookeeper": "0.0.83",
    "@jellybrick/dbus-next": "0.11.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@napi-rs/keyring": "2.1.2",
    "diff": "8.0.4",
    "effect": "4.0.2",
    "eventsource": "5.1.1",
    "hono": "4.13.5",
    "image-size": "2.0.4",
    "jose": "6.2.11",
    "miniflare": "5.20260828.0-alpha",
    "npm-package-arg": "14.0.0",
    "proper-lockfile": "4.1.2",
    "re2js": "1.3.3",
    "semver": "7.8.5",
    "shell-quote": "1.10.0",
    "write-file-atomic": "8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/codemode": "0.5.1",
    "@fungi.computer/mule": "0.4.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "24.13.3",
    "@types/npm-package-arg": "6.1.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.8.0",
    "@types/write-file-atomic": "4.0.3",
    "bun": "1.4.4",
    "bun-types": "1.4.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "runtime",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": {
        "status": "not-applicable",
        "reason": "Truffle ships inside @fungi.computer/spore and owns no generated API documentation surface"
      },
      "pack": {
        "status": "not-applicable",
        "reason": "Truffle is bundled into @fungi.computer/spore and not packed on its own"
      },
      "smoke": {
        "status": "not-applicable",
        "reason": "Focused synthetic persistence and Pi integration tests are the current runtime proof"
      },
      "stranger": {
        "status": "not-applicable",
        "reason": "Truffle is bundled into @fungi.computer/spore; the packed fungi stranger install is its consumer proof"
      }
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
